# Server Port
PORT=3001

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Head Field
SMTP_FROM_EMAIL=

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/thanksgiving?retryWrites=true&w=majority

# Optional (for Vercel online uploads to auto-commit to GitHub public/uploads/ so git pull fetches them)
GITHUB_TOKEN=
GITHUB_REPO=CodeWithJitender/thanks-giving
GITHUB_BRANCH=main
